# SQL Server connection. Copy this file to .env and adjust for your machine.
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=localhost
DB_DATABASE=QLDSV
DB_TRUSTED_CONNECTION=yes

# Absolute directory visible to both this app and the SQL Server service.
# Create it first, then grant the SQL Server service account read/write access.
# For a remote server, use a shared UNC directory rather than a mapped drive.
QLDSV_BACKUP_DIR=

# For SQL Server authentication, set DB_TRUSTED_CONNECTION=no and uncomment:
# DB_USERNAME=your_username
# DB_PASSWORD=your_password
