# Copy this file to .env before running Docker Compose.
# Use a strong local-development password. .env is ignored by Git.
MSSQL_SA_PASSWORD="ChangeMe_QLDSV#2026!"
MSSQL_PORT=14330

# Init-only security settings; existing Login passwords are NEVER reset.
# Replace the Admin placeholder before first bootstrap. Admin policy stays ON.
QLDSV_ADMIN_LOGIN=GV00000001
QLDSV_ADMIN_PASSWORD="ChangeMe_Admin#2026!"
# Must match an existing Sinhvien.MASV. Initial Student password: 123456.
QLDSV_STUDENT_LOGIN=SV00000001

# Application connection target.
# Epic 1.5 will make the Login form connect with each user's own SQL Login.
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=localhost,14330
DB_DATABASE=QLDSV
DB_TRUSTED_CONNECTION=no

# Host folder for backup files. Docker bind-mounts ./backups to
# /var/opt/mssql/backups inside SQL Server. Backup/Restore integration will
# need to distinguish the host path from the SQL Server container path.
QLDSV_BACKUP_DIR=

# Do NOT put a shared privileged DB_USERNAME/DB_PASSWORD here for the target
# architecture. Authentication will use the username/password entered in UI.
